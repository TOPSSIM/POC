# Copy this file and edit the copy, for example:
#   cp topssim/tools/user_profile_campaign.env.example topssim/tools/user_profile_campaign.env
#
# Then run:
#   topssim/tools/run_user_profile_campaign.sh topssim/tools/user_profile_campaign.env

SSH_USER=alexis
HPLMN_IP=172.16.85.100
VPLMN_IP=172.16.85.110
UE_IP=172.16.85.132

LOCAL_OPEN5GS=/Users/alexis/Documents/PhD/TOPSSIM/TestBed5G/open5gs
HPLMN_OPEN5GS=/home/alexis/TOPSSIM/open5gs
VPLMN_OPEN5GS=/home/alexis/TOPSSIM/open5gs
UE_OPEN5GS=/home/alexis/TestBed5G/open5gs

HPLMN_CONFIG=./build/configs/examples/topssim-hplmn.yaml
VPLMN_CONFIG=./build/configs/examples/topssim-vplmn.yaml
UE_CONFIG=./build/configs/examples/topssim-ue.yaml

REPETITIONS=10
YEAR=2026
LOCAL_OUTPUT_DIR=logs/campaign

HOME_AMF_ADDR=172.16.85.128
VISITED_AMF_ADDR=172.16.85.148
TOPSSIM_SDM_CF_PLMN=00102
SKIP_GTPU_PING=1
SKIP_PDU_SESSION=0

MONGO_TUNNEL_PORT=27018
MONGO_REMOTE_HOST=127.0.0.1
MONGO_REMOTE_PORT=27017
VISITED_MONGO_TUNNEL_PORT=27019
VISITED_MONGO_REMOTE_HOST=127.0.0.1
VISITED_MONGO_REMOTE_PORT=27017

RESTART_HPLMN=1
RESTART_VPLMN_EACH_RUN=1
RUN_STANDARD=1
RUN_TOPSSIM=1
CLEAN_OUTPUT=1
STOP_CORES_AT_END=1

# Optional. If set, the script uses it for remote sudo commands and avoids
# interactive [sudo] password prompts during campaign orchestration.
# VM_SUDO_PASSWORD=cassy

CORE_BOOT_WAIT=4
CORE_STOP_WAIT=4
OPEN5GS_PROCESS_NAMES="5gc open5gs-nrfd open5gs-scpd open5gs-seppd open5gs-amfd open5gs-smfd open5gs-upfd open5gs-ausfd open5gs-udmd open5gs-udrd open5gs-pcfd open5gs-nssfd open5gs-bsfd open5gs-mmed open5gs-sgwcd open5gs-sgwud open5gs-hssd open5gs-pcrfd"

HPLMN_ALIAS_SCRIPT=./setup-aliases-vm1.sh
VPLMN_ALIAS_SCRIPT=./setup-aliases-vm2.sh
