%%{init: {
  "theme": "default",
  "sequence": {
    "showSequenceNumbers": false,
    "mirrorActors": false,
    "wrap": true,
    "width": 130
  }
}}%%
sequenceDiagram
    participant UE
    participant gNB
    participant VAMF as V-AMF
    participant VNRF as V-NRF
    participant HUDM as H-UDM
    participant HUDR as H-UDR
    participant VPCF as V-PCF
    participant VSMF as V-SMF
    participant VUPF as V-UPF

    %% Slide-friendly baseline: unmodified Open5GS runtime path.
    %% Details collapsed: Open5GS DB read/write and repeated NRF client setup.
    %% Source-backed full version: full-open5gs-baseline.mmd.

    rect rgb(245,245,245)
    note over UE,VPCF: Registration: profile is fetched on the runtime path
    UE->>gNB: NAS Registration Request
    gNB->>VAMF: NGAP Initial UE Message

    VAMF->>VNRF: Nnrf_NFDiscovery<br/>UDM for Nudm_UECM / Nudm_SDM
    VNRF-->>VAMF: H-UDM NFProfile

    VAMF->>HUDM: Nudm_UECM PUT<br/>AMF 3GPP access registration
    HUDM->>HUDR: Nudr_DR PUT<br/>AMF context
    HUDR-->>HUDM: 204 No Content
    HUDM-->>VAMF: 201 Created / 200 OK

    VAMF->>HUDM: Nudm_SDM GET am-data
    HUDM->>HUDR: Nudr_DR GET am-data
    HUDR-->>HUDM: AccessAndMobilitySubscriptionData
    HUDM-->>VAMF: am-data<br/>UE-AMBR, NSSAI, RAT restrictions

    VAMF->>HUDM: Nudm_SDM GET smf-select-data
    HUDM->>HUDR: Nudr_DR GET smf-selection-subscription-data
    HUDR-->>HUDM: SmfSelectionSubscriptionData
    HUDM-->>VAMF: smf-select-data<br/>DNN / S-NSSAI / LBO flag

    VAMF->>HUDM: Nudm_SDM GET ue-context-in-smf-data
    HUDM-->>VAMF: UE context in SMF data
    VAMF->>HUDM: Nudm_SDM POST sdm-subscriptions
    HUDM-->>VAMF: subscriptionId

    VAMF->>VNRF: Nnrf_NFDiscovery<br/>PCF for AM policy
    VNRF-->>VAMF: V-PCF NFProfile
    VAMF->>VPCF: Npcf_AMPolicyControl POST /policies
    VPCF-->>VAMF: PolicyAssociation

    VAMF-->>gNB: Registration Accept
    gNB-->>UE: Registration Accept
    end

    rect rgb(250,250,250)
    note over UE,VUPF: PDU Session: session profile and policy are still runtime lookups
    UE->>gNB: PDU Session Establishment Request<br/>DNN, S-NSSAI
    gNB->>VAMF: NGAP UL NAS Transport

    VAMF->>VNRF: Nnrf_NFDiscovery<br/>SMF for nsmf-pdusession
    VNRF-->>VAMF: V-SMF NFProfile
    VAMF->>VSMF: Nsmf_PDUSession Create SM Context

    VSMF->>VNRF: Nnrf_NFDiscovery<br/>UDM for Nudm_SDM
    VNRF-->>VSMF: H-UDM NFProfile
    VSMF->>HUDM: Nudm_SDM GET sm-data<br/>DNN, S-NSSAI, serving PLMN
    HUDM->>HUDR: Nudr_DR GET sm-data
    HUDR-->>HUDM: SessionManagementSubscriptionData
    HUDM-->>VSMF: sm-data<br/>QoS, Session-AMBR, PDU type, static IP

    VSMF->>HUDM: Nudm_SDM POST sdm-subscriptions
    HUDM-->>VSMF: subscriptionId
    VSMF-->>VAMF: Nsmf_PDUSession 201 Created

    VSMF->>VNRF: Nnrf_NFDiscovery<br/>PCF for SM policy
    VNRF-->>VSMF: V-PCF NFProfile
    VSMF->>VPCF: Npcf_SMPolicyControl POST /sm-policies
    VPCF-->>VSMF: SmPolicyDecision

    VSMF->>VUPF: PFCP Session Establishment
    VUPF-->>VSMF: PFCP Response
    VSMF->>VAMF: Namf_Communication N1N2 transfer
    VAMF->>gNB: PDU Session Resource Setup
    gNB->>UE: PDU Session Establishment Accept
    end
