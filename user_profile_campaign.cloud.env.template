# Private campaign env template.
# Copy to topssim/tools/user_profile_campaign.cloud.env and edit locally.
# Do not commit or share the edited file if it contains private IPs/passwords.

SSH_USER=root
HPLMN_IP=<HPLMN_PUBLIC_IP>
VPLMN_IP=<VPLMN_PUBLIC_IP>
UE_IP=<UE_PUBLIC_IP>

LOCAL_OPEN5GS=/path/on/controller/open5gs
HPLMN_OPEN5GS=/home/alexis/TOPSSIM/open5gs
VPLMN_OPEN5GS=/home/alexis/TOPSSIM/open5gs
UE_OPEN5GS=/home/alexis/TestBed5G/open5gs

HPLMN_CONFIG=./build/configs/examples/topssim-hplmn-cloud.yaml
VPLMN_CONFIG=./build/configs/examples/topssim-vplmn-cloud.yaml
UE_CONFIG=./build/configs/examples/topssim-ue-cloud.yaml

REPETITIONS=20
YEAR=2026
LOCAL_OUTPUT_DIR=logs/campaign-pdu-20

HOME_AMF_ADDR=<HPLMN_PUBLIC_IP>
VISITED_AMF_ADDR=<VPLMN_PUBLIC_IP>
TOPSSIM_SDM_CF_PLMN=00102

# Keep PDU enabled for the full user-profile comparison because sm-data is
# fetched during PDU session setup.
SKIP_GTPU_PING=1
SKIP_PDU_SESSION=0
UE_TEST_TIMEOUT=180
ALLOW_UE_TEST_FAILURE=1

# Single-public-IP cloud mode: UE opens local HTTP tunnels toward NRF/UDM.
PREP_HTTP_TUNNELS=1
HPLMN_NRF_TUNNEL_ADDR=127.10.0.10
HPLMN_UDM_TUNNEL_ADDR=127.10.0.12
VPLMN_NRF_TUNNEL_ADDR=127.20.0.10
VPLMN_UDM_TUNNEL_ADDR=127.20.0.12
HPLMN_NRF_REMOTE_ADDR=127.0.1.10
HPLMN_UDM_REMOTE_ADDR=127.0.1.12
VPLMN_NRF_REMOTE_ADDR=127.0.2.10
VPLMN_UDM_REMOTE_ADDR=127.0.2.12
PREP_HTTP_PORT=80

MONGO_TUNNEL_PORT=27018
MONGO_REMOTE_HOST=127.0.0.1
MONGO_REMOTE_PORT=27017
VISITED_MONGO_TUNNEL_PORT=27019
VISITED_MONGO_REMOTE_HOST=127.0.0.1
VISITED_MONGO_REMOTE_PORT=27017

RESTART_HPLMN=1
RESTART_VPLMN_EACH_RUN=1
RUN_STANDARD=1
RUN_TOPSSIM=1
CLEAN_OUTPUT=1
STOP_CORES_AT_END=1

# Prefer passwordless sudo. If unavailable, uncomment locally.
# VM_SUDO_PASSWORD=<sudo-password>

CORE_BOOT_WAIT=5
CORE_STOP_WAIT=6
OPEN5GS_PROCESS_NAMES="5gc open5gs-nrfd open5gs-scpd open5gs-seppd open5gs-amfd open5gs-smfd open5gs-upfd open5gs-ausfd open5gs-udmd open5gs-udrd open5gs-pcfd open5gs-nssfd open5gs-bsfd open5gs-mmed open5gs-sgwcd open5gs-sgwud open5gs-hssd open5gs-pcrfd"

# In cloud-single-ip mode no Linux alias script is normally required.
HPLMN_ALIAS_SCRIPT=./no-alias-needed.sh
VPLMN_ALIAS_SCRIPT=./no-alias-needed.sh

